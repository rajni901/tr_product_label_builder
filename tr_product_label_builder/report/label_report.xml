<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_product_label" model="ir.actions.report">
        <field name="name">Product Label</field>
        <field name="model">print.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tr_product_label_builder.report_product_label</field>
        <field name="report_file">tr_product_label_builder.report_product_label</field>
        <field name="print_report_name">'Product Labels'</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_product_label">
        <t t-call="web.html_container">
            <t t-set="company" t-value="env.company"/>
            <div style="padding:10px; background:#f0f0f0;">
                <t t-foreach="labels" t-as="label">
                    <t t-set="product" t-value="label['product']"/>
                    <t t-set="template" t-value="label['template']"/>
                    <t t-set="pricelist" t-value="label['pricelist']"/>
                    <t t-call="tr_product_label_builder.single_label"/>
                </t>
            </div>
        </t>
    </template>

    <template id="single_label">
        <!-- Outer card -->
        <div style="background:#ffffff; border-radius:12px; margin:8px auto; width:100mm; box-shadow:0 2px 8px rgba(0,0,0,0.12); overflow:hidden; font-family:Arial,sans-serif; page-break-inside:avoid;">

            <!-- Top bar: logo + company name -->
            <div t-attf-style="background:#{template.header_color or '#6c3fc5'}; display:flex; align-items:center; gap:6px; padding:5px 10px;">
                <t t-if="template.show_logo and company.logo">
                    <div style="background:#fff; border-radius:50%; width:22px; height:22px; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
                        <img t-att-src="image_data_uri(company.logo)"
                             style="width:18px; height:18px; object-fit:contain;" alt=""/>
                    </div>
                </t>
                <span style="font-size:7pt; font-weight:700; color:#ffffff; letter-spacing:0.5px;"
                      t-esc="company.name"/>
            </div>

            <!-- Product Info -->
            <div style="padding:8px 10px 4px;">
                <t t-if="template.show_name">
                    <div style="font-size:11pt; font-weight:800; color:#1a1a1a; line-height:1.2; margin-bottom:2px;"
                         t-esc="product.name"/>
                </t>
                <t t-if="template.show_internal_ref and product.default_code">
                    <div style="font-size:7pt; color:#888; margin-bottom:2px;">
                        <t t-if="product.product_template_attribute_value_ids">
                            <t t-esc="product.default_code"/> |
                            <t t-esc="', '.join(product.product_template_attribute_value_ids.mapped('name'))"/>
                        </t>
                        <t t-else="">
                            <t t-esc="product.default_code"/>
                        </t>
                    </div>
                </t>
                <t t-if="template.show_category and product.categ_id">
                    <div style="font-size:6.5pt; color:#aaa;" t-esc="product.categ_id.name"/>
                </t>
            </div>

            <!-- Bottom row: barcode left + price right -->
            <div style="display:flex; align-items:stretch; margin-top:4px;">

                <!-- Barcode section -->
                <div style="flex:1; padding:4px 10px 8px;">
                    <t t-if="template.show_barcode and product.barcode">
                        <div t-out="product.barcode"
                             t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width:100%; max-height:38px;'}"/>
                        <div style="font-size:5.5pt; color:#999; letter-spacing:1px; text-align:center; margin-top:1px;"
                             t-esc="product.barcode"/>
                    </t>
                    <t t-if="template.show_qr_code and product.barcode">
                        <div style="margin-top:4px;">
                            <div t-out="product.barcode"
                                 t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': 'width:45px;height:45px;'}"/>
                        </div>
                    </t>
                </div>

                <!-- Price badge -->
                <t t-if="template.show_price">
                    <div t-attf-style="background:#{template.header_color or '#6c3fc5'}; display:flex; align-items:center; justify-content:center; padding:8px 14px; min-width:22mm; border-radius:0 0 0 12px;">
                        <span style="font-size:14pt; font-weight:900; color:#ffffff; white-space:nowrap;">
                            <t t-esc="product.currency_id.symbol"/>
                            <t t-esc="'%.2f' % product.lst_price"/>
                        </span>
                    </div>
                </t>
            </div>

            <!-- Footer Note -->
            <t t-if="template.notes">
                <div style="font-size:6pt; color:#bbb; text-align:center; padding:3px; border-top:1px solid #f0f0f0;"
                     t-esc="template.notes"/>
            </t>
        </div>
    </template>

</odoo>

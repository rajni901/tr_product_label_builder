<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_product_label" model="ir.actions.report">
        <field name="name">Product Label</field>
        <field name="model">print.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tr_product_label_builder.report_product_label</field>
        <field name="report_file">tr_product_label_builder.report_product_label</field>
        <field name="print_report_name">'Product Labels'</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_product_label">
        <t t-call="web.html_container">
            <t t-set="company" t-value="env.company"/>
            <div class="tr-label-a4-page">
                <t t-foreach="labels" t-as="label">
                    <t t-set="product" t-value="label['product']"/>
                    <t t-set="template" t-value="label['template']"/>
                    <t t-set="pricelist" t-value="label['pricelist']"/>
                    <t t-call="tr_product_label_builder.single_label"/>
                </t>
            </div>
        </t>
    </template>

    <template id="single_label">
        <div t-att-class="'tr-label-card tr-label-' + (template.label_size or '100x50')"
             t-attf-style="border: 2px solid #{template.header_color or '#1a1a5e'}; border-radius:6px; overflow:hidden; background:#fff; display:inline-block; margin:4px; font-family:Arial,sans-serif; color: #{template.text_color or '#2d2d2d'}; min-width:100mm; max-width:120mm;">

            <!-- Header -->
            <div t-attf-style="background: #{template.header_color or '#1a1a5e'}; display:flex; align-items:center; justify-content:space-between; padding:4px 8px; height:28px; overflow:hidden;">
                <t t-if="template.show_logo and company.logo">
                    <img t-att-src="image_data_uri(company.logo)"
                         style="height:20px; width:auto; max-width:55px; object-fit:contain;"
                         alt="Logo"/>
                </t>
                <span style="font-size:6pt; color:rgba(255,255,255,0.9); font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                      t-esc="company.name"/>
            </div>

            <!-- Product Name -->
            <t t-if="template.show_name">
                <div style="padding:6px 8px 2px; font-weight:700; font-size:10pt; color:#1a1a5e; line-height:1.2;"
                     t-esc="product.name"/>
            </t>

            <!-- Internal Reference -->
            <t t-if="template.show_internal_ref and product.default_code">
                <div style="padding:1px 8px; font-size:7.5pt; color:#666;">
                    SKU: <span t-esc="product.default_code"/>
                </div>
            </t>

            <!-- Category -->
            <t t-if="template.show_category and product.categ_id">
                <div style="padding:1px 8px; font-size:7pt; color:#888; font-style:italic;"
                     t-esc="product.categ_id.name"/>
            </t>

            <!-- Price -->
            <t t-if="template.show_price">
                <div style="padding:3px 8px; font-size:13pt; font-weight:800; color:#1a1a5e;">
                    <t t-esc="product.currency_id.symbol"/>
                    <t t-esc="'%.2f' % product.lst_price"/>
                </div>
            </t>

            <!-- Barcode -->
            <t t-if="template.show_barcode and product.barcode">
                <div style="padding:4px 8px; text-align:center;">
                    <div t-out="product.barcode"
                         t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width:90%;max-height:45px;'}"/>
                    <div style="font-size:6pt; color:#555; letter-spacing:1px; margin-top:1px;"
                         t-esc="product.barcode"/>
                </div>
            </t>

            <!-- QR Code -->
            <t t-if="template.show_qr_code and product.barcode">
                <div style="padding:2px 8px; text-align:center;">
                    <div t-out="product.barcode"
                         t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': 'width:55px;height:55px;'}"/>
                </div>
            </t>

            <!-- Footer Note -->
            <t t-if="template.notes">
                <div style="padding:3px 8px; font-size:6pt; color:#aaa; text-align:center; border-top:1px solid #eee;"
                     t-esc="template.notes"/>
            </t>
        </div>
    </template>

</odoo>

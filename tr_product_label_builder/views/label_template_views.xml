<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_label_template_form" model="ir.ui.view">
        <field name="name">product.label.template.form</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <form string="Label Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group string="Label Size">
                            <field name="label_size"/>
                        </group>
                        <group string="Styling">
                            <field name="header_color" widget="color"/>
                            <field name="text_color" widget="color"/>
                            <field name="font_size"/>
                            <field name="notes" placeholder="e.g. www.yourstore.com"/>
                        </group>
                    </group>
                    <group string="Fields to Display">
                        <group>
                            <field name="show_name"/>
                            <field name="show_internal_ref"/>
                            <field name="show_barcode"/>
                            <field name="show_qr_code"/>
                        </group>
                        <group>
                            <field name="show_price"/>
                            <field name="show_category"/>
                            <field name="show_logo"/>
                            <field name="show_lot"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_label_template_list" model="ir.ui.view">
        <field name="name">product.label.template.list</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates">
                <field name="name"/>
                <field name="label_size"/>
                <field name="show_barcode"/>
                <field name="show_price"/>
                <field name="show_logo"/>
            </list>
        </field>
    </record>

    <record id="action_label_template" model="ir.actions.act_window">
        <field name="name">Label Templates</field>
        <field name="res_model">product.label.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_label_builder_root"
              name="Label Builder"
              parent="stock.menu_stock_config_settings"
              sequence="25"/>

    <menuitem id="menu_label_templates"
              name="Label Templates"
              parent="menu_label_builder_root"
              action="action_label_template"
              sequence="1"/>

</odoo>

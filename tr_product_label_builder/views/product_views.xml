<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Print Labels button on Product Template list -->
    <record id="view_product_template_label_button" model="ir.ui.view">
        <field name="name">product.template.label.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(tr_product_label_builder.action_print_label_wizard)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-tag"
                        string="Print Label"
                        context="{'active_model': 'product.template', 'active_ids': [id]}"/>
            </xpath>
        </field>
    </record>

    <!-- Action in product list view -->
    <record id="action_product_print_label" model="ir.actions.server">
        <field name="name">Print Labels</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Print Labels',
    'res_model': 'print.label.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'active_model': 'product.template',
        'active_ids': records.ids,
    },
}
        </field>
    </record>

</odoo>
